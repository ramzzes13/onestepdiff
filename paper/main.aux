\newlabel{app:details}{{A}{9}{}{appendix.A}{}}
\newlabel{app:details@cref}{{[appendix][1][2147483647]A}{[1][9][]9}}
\newlabel{app:dynamics}{{B}{9}{}{appendix.B}{}}
\newlabel{app:dynamics@cref}{{[appendix][2][2147483647]B}{[1][9][]9}}
\newlabel{fig:training_dynamics}{{7}{10}{Training dynamics comparison: decaying regression (v5b, blue) vs.\ constant regression (v5c, orange). (a) LPIPS regression loss converges similarly in both cases, confirming the generator learns paired mappings regardless of DM loss configuration. (b) NCE accuracy drops from $\sim $87\% (Phase 1) to $\sim $50\% (Phase 2) as distributions become harder to distinguish after the DM loss activates. (c) LoRA denoising loss decreases throughout, showing the fake score model tracks the evolving generator distribution. (d) Output standard deviation remains above 0.35 for both schedules, confirming no mean collapse occurs. Dashed gray line marks the Phase 1/Phase 2 transition at step 5,000}{figure.7}{}}
\newlabel{fig:training_dynamics@cref}{{[figure][7][2147483647]7}{[1][9][]10}}
\newlabel{app:samples}{{C}{10}{}{appendix.C}{}}
\newlabel{app:samples@cref}{{[appendix][3][2147483647]C}{[1][10][]10}}
\newlabel{fig:qualitative}{{8}{11}{Qualitative comparison on CIFAR-10 32$\times $32 (best model: warmup=2K at 35K steps, FID 55.45). Top: 100-step DDPM teacher outputs. Middle: AdaDMD single-step outputs from random noise. Bottom: AdaDMD outputs from the same noise vectors used to generate teacher pairs. The student captures coarse structure and color statistics while maintaining diversity}{figure.8}{}}
\newlabel{fig:qualitative@cref}{{[figure][8][2147483647]8}{[1][10][]11}}
